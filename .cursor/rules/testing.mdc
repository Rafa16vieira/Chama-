description: Estratégia e padrões de testes automatizados e manuais
globs: "**/*.test.ts,**/*.test.tsx,**/*.spec.ts,**/*.spec.tsx,**/tests/**,**/__tests__/**,**/e2e/**"
alwaysApply: false
